@inject MidtermProject.Services.KeylabStoreService Store
@using MidtermProject.Models

@if (ListView)
{
    <div class="glass-card-hover p-4 flex gap-5 items-center">
        <a href="/product/@Product.Id" class="shrink-0">
            <img src="@Product.PrimaryImageUrl" alt="@Product.Name" loading="lazy" class="h-28 w-40 object-cover rounded-xl" />
        </a>
        <div class="flex-1 min-w-0">
            <div class="flex flex-wrap gap-1.5 mb-1.5">@Badges</div>
            <a href="/product/@Product.Id" class="font-extrabold text-white hover:text-neon-cyan transition-colors">@Product.Name</a>
            <p class="text-xs text-slate-400 mt-1 line-clamp-2">@Product.Description</p>
            <p class="text-xs text-amber-400 mt-1.5">★ @Product.Rating.ToString("0.0") <span class="text-slate-500">(@Product.ReviewCount)</span></p>
        </div>
        <div class="text-right space-y-2">
            <p class="text-xl font-black text-white">$@Product.Price.ToString("N2")</p>
            <button @onclick="Add" disabled="@(!Product.InStock)" class="btn-primary !py-2 !px-4 !text-xs">@(Product.InStock ? "Add to Cart" : "Sold out")</button>
        </div>
    </div>
}
else
{
    <div class="glass-card-hover p-4 flex flex-col h-full group">
        <a href="/product/@Product.Id" class="relative block overflow-hidden rounded-xl">
            <img src="@Product.PrimaryImageUrl" alt="@Product.Name" loading="lazy" class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105 @(Product.InStock ? "" : "grayscale opacity-60")" />
            <div class="absolute top-2 left-2 flex flex-wrap gap-1.5">@Badges</div>
        </a>
        <div class="mt-3 flex-1">
            <a href="/product/@Product.Id" class="font-extrabold text-white hover:text-neon-cyan transition-colors">@Product.Name</a>
            <p class="text-xs text-amber-400 mt-1">★ @Product.Rating.ToString("0.0") <span class="text-slate-500">(@Product.ReviewCount)</span></p>
        </div>
        <div class="flex items-center justify-between mt-4 pt-3 border-t border-white/10">
            <span class="text-lg font-black text-white">$@Product.Price.ToString("N2")</span>
            <button @onclick="Add" disabled="@(!Product.InStock)" class="btn-primary !py-2 !px-3.5 !text-xs">@(Product.InStock ? "Add to Cart" : "Sold out")</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public bool ListView { get; set; }

    private void Add() => Store.AddToCart(Product, Product.Color, Product.SwitchOptions.FirstOrDefault() ?? "Linear");

    private RenderFragment Badges => @<text>
        @if (Product.IsOnSale) { <span class="chip !border-red-500/50 !bg-red-500/20 !text-red-300">SALE</span> }
        @if (!Product.InStock) { <span class="chip">SOLD OUT</span> }
        else if (Product.IsLowStock) { <span class="chip !border-amber-500/50 !text-amber-300">ONLY @Product.Stock LEFT</span> }
        @if (Product.IsKeyboard) { <span class="chip-neon">@Product.Layout</span> }
    </text>;
}
