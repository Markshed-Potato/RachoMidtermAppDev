<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="app.min.css" />
    <HeadOutlet @rendermode="Interactive" />
</head>

<body>
    <Routes @rendermode="Interactive" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Prerender off: the circuit owns the cart/session, so auth redirects and cart state are not lost on first load.
    private static readonly InteractiveServerRenderMode Interactive = new(prerender: false);
}
