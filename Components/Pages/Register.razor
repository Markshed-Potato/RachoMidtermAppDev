@page "/register"
@inject MidtermProject.Services.KeylabStoreService Store
@inject NavigationManager Nav

<PageTitle>Create Account — KEYLAB</PageTitle>

<div class="min-h-[calc(100vh-10rem)] flex items-center justify-center px-4">
    <div class="glass-card max-w-4xl w-full overflow-hidden grid md:grid-cols-2 shadow-glow-violet animate-fade-up">
        <div class="relative hidden md:flex flex-col justify-between p-8 bg-gradient-to-br from-neon-violet/25 via-ink-900 to-neon-cyan/10 overflow-hidden">
            <div class="absolute inset-0 grid-bg"></div>
            <div class="relative">
                <span class="chip-neon font-mono tracking-widest">KEYLAB MEMBERSHIP</span>
                <h2 class="text-3xl font-black mt-4 leading-tight">Elevate your <span class="text-gradient">typing</span>.</h2>
                <p class="text-slate-400 text-sm mt-3">Join enthusiasts building custom setups. Save carts, track orders, get early access to drops.</p>
                <div class="flex gap-2 mt-6">
                    @foreach (var k in new[] { "K", "E", "Y" }) { <span class="keycap">@k</span> }
                </div>
            </div>
            <div class="relative glass rounded-xl p-4">
                <p class="text-xs text-slate-300 italic">“The build quality of the Void 65 changed how I feel about typing every day.”</p>
                <span class="text-[10px] text-neon-cyan font-bold mt-2 block">— Alex R., Software Engineer</span>
            </div>
        </div>

        <div class="p-8 flex flex-col justify-center">
            <h1 class="text-2xl font-black text-center">Create account</h1>
            <p class="text-slate-400 text-xs text-center mt-1 mb-6">Join KEYLAB in under a minute.</p>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-xs p-3 rounded-xl mb-4 font-semibold">@_error</div>
            }

            <EditForm Model="_model" FormName="registerForm" OnValidSubmit="HandleRegister" class="space-y-5">
                <DataAnnotationsValidator />

                <div class="float-field">
                    <InputText @bind-Value="_model.FullName" class="input peer" placeholder=" " autocomplete="name" />
                    <label>Full name</label>
                    <ValidationMessage For="() => _model.FullName" />
                </div>
                <div class="float-field">
                    <InputText @bind-Value="_model.Email" class="input peer" placeholder=" " autocomplete="email" />
                    <label>Email address</label>
                    <ValidationMessage For="() => _model.Email" />
                </div>
                <div class="float-field">
                    <InputText @bind-Value="_model.Password" type="@(_show ? "text" : "password")" class="input peer pr-14" placeholder=" " autocomplete="new-password" />
                    <label>Password</label>
                    <button type="button" @onclick="() => _show = !_show" class="absolute right-3 top-3 text-[11px] font-bold text-slate-400 hover:text-neon-cyan">@(_show ? "HIDE" : "SHOW")</button>
                    <ValidationMessage For="() => _model.Password" />
                </div>
                <div class="float-field">
                    <InputText @bind-Value="_model.ConfirmPassword" type="@(_show ? "text" : "password")" class="input peer" placeholder=" " autocomplete="new-password" />
                    <label>Confirm password</label>
                    <ValidationMessage For="() => _model.ConfirmPassword" />
                </div>

                <div>
                    <div class="flex items-center gap-2">
                        <InputCheckbox @bind-Value="_model.AgreeToTerms" id="agree" class="accent-cyan-400 h-4 w-4 cursor-pointer" />
                        <label for="agree" class="text-xs text-slate-400 cursor-pointer">I agree to the <a href="#" class="text-neon-cyan hover:underline">Terms &amp; Privacy Policy</a></label>
                    </div>
                    <ValidationMessage For="() => _model.AgreeToTerms" />
                </div>

                <button type="submit" class="btn-primary w-full !py-3.5">Create Account</button>
            </EditForm>

            <p class="text-xs text-slate-500 text-center mt-6">Already a member? <a href="/login" class="text-neon-cyan hover:underline">Sign in</a></p>
        </div>
    </div>
</div>

@code {
    private readonly MidtermProject.Models.RegisterModel _model = new();
    private string _error = "";
    private bool _show;

    private void HandleRegister()
    {
        var (ok, error) = Store.Register(_model.FullName, _model.Email, _model.Password);
        if (!ok) { _error = error; return; }

        Store.ShowToast($"Welcome to KEYLAB, {Store.CurrentUser}!");
        Nav.NavigateTo("/home");
    }
}
