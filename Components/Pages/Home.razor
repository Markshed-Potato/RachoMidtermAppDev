@page "/home"
@inject MidtermProject.Services.KeylabStoreService StoreService

<PageTitle>KEYLAB — Minimalist Mechanical Keyboards</PageTitle>

<div class="max-w-7xl mx-auto px-6 py-12 space-y-20">
    <!-- Hero Banner -->
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center bg-slate-900 rounded-3xl p-8 lg:p-12 border border-slate-800">
        <div>
            <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest">NEW: SLATE 75 WIRELESS</span>
            <h1 class="text-4xl lg:text-5xl font-black text-white mt-2 leading-tight">Type quieter. Think louder.</h1>
            <p class="text-slate-400 text-sm mt-4 max-w-md">Hand-tuned mechanical keyboards in a clean, minimal form factor designed for long typing sessions and peak focus.</p>
            <div class="mt-6 flex flex-wrap gap-3">
                <a href="/shop?cat=Keyboards" class="bg-indigo-600 text-white text-sm font-semibold px-6 py-3 rounded-xl hover:bg-indigo-500 transition-all shadow-md">Shop Keyboards</a>
                <a href="/shop" class="border border-slate-700 text-slate-200 text-sm font-semibold px-6 py-3 rounded-xl hover:bg-slate-800 transition-all">Browse All Products</a>
            </div>
        </div>
        <div class="overflow-hidden rounded-2xl shadow-xl border border-slate-800 bg-slate-950">
            <img src="https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=800&auto=format&fit=crop" alt="Slate 75 Keyboard" class="w-full h-80 object-cover" />
        </div>
    </section>

    <!-- Shop By Category (All 4 Categories) -->
    <section>
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-black text-white">Shop by Category</h2>
            <a href="/shop" class="text-xs font-bold text-indigo-400 hover:underline">View All &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <a href="/shop?cat=Keyboards" class="group bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-indigo-500 transition-all shadow-sm">
                <div class="overflow-hidden rounded-xl bg-slate-950">
                    <img src="https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&auto=format&fit=crop" alt="Keyboards" class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-bold text-white mt-3 text-center">Keyboards</h3>
                <p class="text-[11px] text-slate-400 text-center mt-0.5">Prebuilts & DIY Kits</p>
            </a>
            <a href="/shop?cat=Switches" class="group bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-indigo-500 transition-all shadow-sm">
                <div class="overflow-hidden rounded-xl bg-slate-950">
                    <img src="https://images.unsplash.com/photo-1595044426077-d36d9236d54a?w=500&auto=format&fit=crop" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&auto=format&fit=crop';" alt="Switches" class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-bold text-white mt-3 text-center">Switches</h3>
                <p class="text-[11px] text-slate-400 text-center mt-0.5">Linear, Tactile & Clicky</p>
            </a>
            <a href="/shop?cat=Keycaps" class="group bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-indigo-500 transition-all shadow-sm">
                <div class="overflow-hidden rounded-xl bg-slate-950">
                    <img src="https://images.unsplash.com/photo-1595225476474-87563907a212?w=500&auto=format&fit=crop" alt="Keycaps" class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-bold text-white mt-3 text-center">Keycaps</h3>
                <p class="text-[11px] text-slate-400 text-center mt-0.5">PBT Dye-Sub Sets</p>
            </a>
            <a href="/shop?cat=Accessories" class="group bg-slate-900 p-4 rounded-2xl border border-slate-800 hover:border-indigo-500 transition-all shadow-sm">
                <div class="overflow-hidden rounded-xl bg-slate-950">
                    <img src="https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=500&auto=format&fit=crop" alt="Accessories" class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
                <h3 class="font-bold text-white mt-3 text-center">Accessories</h3>
                <p class="text-[11px] text-slate-400 text-center mt-0.5">Cables & Desk Mats</p>
            </a>
        </div>
    </section>

    <!-- Trending Products -->
    <section>
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-black text-white">Featured Products</h2>
            <a href="/shop" class="text-xs font-bold text-indigo-400 hover:underline">View All &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var p in StoreService.GetProducts().Take(4))
            {
                <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 flex flex-col justify-between shadow-sm hover:border-slate-700 transition-all group">
                    <div>
                        <div class="relative overflow-hidden rounded-xl mb-3 bg-slate-950">
                            @if (p.IsOnSale)
                            {
                                <span class="absolute top-2 left-2 z-10 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase">Sale</span>
                            }
                            <a href="/product/@p.Id">
                                <img src="@p.PrimaryImageUrl" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&auto=format&fit=crop';" alt="@p.Name" class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300" />
                            </a>
                        </div>
                        <div class="text-[11px] text-indigo-400 font-semibold mb-1">@p.Category</div>
                        <a href="/product/@p.Id" class="block font-bold text-white text-sm hover:text-indigo-400 transition-colors">
                            @p.Name
                        </a>
                        <p class="text-xs text-amber-500 mt-1">★ @p.Rating.ToString("F1") <span class="text-slate-400">(@p.ReviewCount)</span></p>
                    </div>
                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-800">
                        <span class="font-black text-white">$@p.Price.ToString("N2")</span>
                        <button @onclick="() => StoreService.AddToCart(p)" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-3 py-2 rounded-lg transition-all shadow-md">
                            Add to Cart
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>
</div>
