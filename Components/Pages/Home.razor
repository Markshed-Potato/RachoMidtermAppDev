@page "/"
@page "/home"
@inject MidtermProject.Services.KeylabStoreService Store
@using MidtermProject.Models

<PageTitle>KEYLAB — Premium Mechanical Keyboards</PageTitle>

<div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-24">
    <!-- Hero -->
    <section class="relative overflow-hidden glass rounded-[2rem] p-8 lg:p-14 grid lg:grid-cols-2 gap-10 items-center">
        <div class="absolute inset-0 grid-bg pointer-events-none"></div>
        <div class="relative animate-fade-up">
            <span class="chip-neon font-mono tracking-widest">NEW DROP · @(_featured?.Name.ToUpper() ?? "SLATE 75")</span>
            <h1 class="mt-5 text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight">Type quieter.<br /><span class="text-gradient">Think louder.</span></h1>
            <p class="mt-5 text-slate-400 max-w-md">Hand-tuned, gasket-mounted, pre-lubed. Premium boards, switches and keycaps for people who care how typing sounds and feels.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/shop?cat=Keyboards" class="btn-primary">Shop Keyboards →</a>
                <a href="/shop" class="btn-ghost">Browse All</a>
            </div>
            <div class="mt-8 flex flex-wrap gap-2">
                @foreach (var b in new[] { "Hot-swap", "Gasket mount", "PBT keycaps", "2.4G / BT / USB-C", "Pre-lubed" })
                {
                    <span class="chip">@b</span>
                }
            </div>
        </div>
        <div class="relative animate-float">
            <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-tr from-neon-cyan/30 to-neon-violet/30 blur-3xl"></div>
            <img src="@(_featured?.PrimaryImageUrl ?? "https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=900&auto=format&fit=crop")" alt="Featured keyboard" class="relative rounded-2xl border border-white/15 h-80 lg:h-96 w-full object-cover shadow-glow-violet" />
            @if (_featured != null)
            {
                <a href="/product/@_featured.Id" class="absolute bottom-4 left-4 glass rounded-xl px-4 py-2.5 hover:border-neon-cyan/50 transition">
                    <span class="block text-sm font-extrabold">@_featured.Name</span>
                    <span class="text-xs text-neon-cyan font-bold">From $@_featured.Price.ToString("N0")</span>
                </a>
            }
        </div>
    </section>

    <!-- Categories -->
    <section>
        <h2 class="section-title mb-8">Shop by <span class="text-gradient">category</span></h2>
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
            @foreach (var c in _categories)
            {
                <a href="@c.Href" class="glass-card-hover group overflow-hidden relative h-52">
                    <img src="@c.Image" alt="@c.Title" loading="lazy" class="absolute inset-0 h-full w-full object-cover opacity-50 group-hover:opacity-70 group-hover:scale-105 transition duration-500" />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/40 to-transparent"></div>
                    <div class="absolute bottom-0 p-4">
                        <h3 class="font-extrabold">@c.Title</h3>
                        <p class="text-[11px] text-slate-400">@c.Sub</p>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- Trending -->
    <section>
        <div class="flex items-end justify-between mb-8">
            <h2 class="section-title">Trending <span class="text-gradient">now</span></h2>
            <a href="/shop" class="text-xs font-bold text-neon-cyan hover:underline">View all →</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            @foreach (var p in _trending)
            {
                <MidtermProject.Components.Shared.ProductCard Product="p" />
            }
        </div>
    </section>

    <!-- Specs strip -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        @foreach (var s in new[] { ("5-pin", "Hot-swap sockets"), ("3 mm", "Gasket-mounted plate"), ("PBT", "Double-shot keycaps"), ("3-way", "Wired · BT · 2.4G") })
        {
            <div class="glass-card p-5 text-center">
                <p class="font-mono text-2xl font-bold text-neon-cyan">@s.Item1</p>
                <p class="text-xs text-slate-400 mt-1">@s.Item2</p>
            </div>
        }
    </section>

    <!-- Reviews -->
    <section>
        <h2 class="section-title mb-8">Loved by <span class="text-gradient">enthusiasts</span></h2>
        <div class="grid md:grid-cols-3 gap-5">
            @foreach (var r in _reviews)
            {
                <figure class="glass-card p-6 flex flex-col">
                    <p class="text-amber-400 text-sm">@("★★★★★")</p>
                    <blockquote class="text-sm text-slate-300 mt-3 flex-1 leading-relaxed">“@r.Quote”</blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <span class="grid place-items-center h-9 w-9 rounded-full bg-gradient-to-br from-neon-violet to-neon-cyan text-ink-950 text-xs font-black">@r.Name[0]</span>
                        <span><span class="block text-sm font-bold">@r.Name</span><span class="text-[11px] text-slate-500">@r.Role</span></span>
                    </figcaption>
                </figure>
            }
        </div>
    </section>
</div>

@code {
    private Product? _featured;
    private List<Product> _trending = new();

    private record Cat(string Title, string Sub, string Href, string Image);
    private readonly Cat[] _categories =
    {
        new("Custom Keyboards", "60% to full-size", "/shop?cat=Keyboards", "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&auto=format&fit=crop"),
        new("Keycaps", "PBT · dye-sub", "/shop?cat=Keycaps", "https://images.unsplash.com/photo-1595225476474-87563907a212?w=500&auto=format&fit=crop"),
        new("Switches", "Linear · tactile · clicky", "/shop?cat=Switches", "https://images.unsplash.com/photo-1541140532154-b024d705b909?w=500&auto=format&fit=crop"),
        new("Deskmats & Gear", "Cables and accessories", "/shop?cat=Accessories", "https://images.unsplash.com/photo-1618384887929-16ec33fab9ef?w=500&auto=format&fit=crop"),
        new("DIY Kits", "Build it yourself", "/shop?q=Kit", "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=500&auto=format&fit=crop&sat=-60"),
    };

    private record Review(string Name, string Role, string Quote);
    private readonly Review[] _reviews =
    {
        new("Alex R.", "Software Engineer", "The build quality of the Void 65 changed how I feel about typing every day."),
        new("Mika T.", "Designer", "Slate 75 sounds unreal out of the box. Shipping was fast and packaging was immaculate."),
        new("Jon D.", "Hobbyist", "Swapped in the tactile set and it's the best upgrade I've made. Easy hot-swap."),
    };

    protected override async Task OnInitializedAsync()
    {
        var all = await Store.GetProductsAsync();
        _featured = all.FirstOrDefault(p => p.IsKeyboard && p.IsOnSale) ?? all.FirstOrDefault();
        _trending = all.Where(p => p.InStock).OrderByDescending(p => p.Rating).Take(4).ToList();
    }
}
