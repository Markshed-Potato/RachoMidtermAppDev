@page "/checkout"
@inject MidtermProject.Services.KeylabStoreService StoreService
@inject NavigationManager Nav

<PageTitle>Checkout — KEYLAB</PageTitle>

<div class="max-w-5xl mx-auto px-6 py-12">
    @if (order != null)
    {
        <div class="max-w-lg mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center shadow-2xl">
            <div class="mx-auto w-14 h-14 rounded-full bg-indigo-600 text-white flex items-center justify-center text-2xl font-black">✓</div>
            <h1 class="text-2xl font-black text-white mt-4">Order placed!</h1>
            <p class="text-slate-400 text-sm mt-1">Thanks, @order.CustomerName. Your order <span class="text-indigo-400 font-bold">@order.Id</span> is confirmed.</p>
            <div class="text-left mt-6 space-y-2 text-xs text-slate-300">
                @foreach (var i in order.Items)
                {
                    <div class="flex justify-between"><span>@i.Quantity × @i.Product.Name (@i.SelectedSwitch)</span><span>$@i.Subtotal.ToString("N2")</span></div>
                }
                <div class="flex justify-between border-t border-slate-800 pt-2 font-black text-white text-sm"><span>Total</span><span>$@order.Total.ToString("N2")</span></div>
                <p class="text-slate-500 pt-2">Ship to: @order.Address</p>
                <p class="text-slate-500">Payment: @order.PaymentMethod</p>
            </div>
            <a href="/shop" class="block mt-6 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl text-sm">Continue Shopping</a>
        </div>
    }
    else if (!StoreService.Cart.Any())
    {
        <h1 class="text-3xl font-black text-white mb-4">Checkout</h1>
        <p class="text-slate-400 text-sm">Your cart is empty. <a href="/shop" class="text-indigo-400 hover:underline">Browse products</a></p>
    }
    else
    {
        <h1 class="text-3xl font-black text-white mb-6">Checkout</h1>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
            <div class="lg:col-span-3 bg-slate-900 border border-slate-800 rounded-3xl p-6">
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="bg-red-500/10 border border-red-500/50 text-red-400 text-xs p-3 rounded-xl mb-4 font-semibold">@error</div>
                }
                <EditForm Model="model" FormName="checkoutForm" OnValidSubmit="Pay" class="space-y-3">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-red-400 text-xs" />

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
                        <InputText @bind-Value="model.FullName" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Address</label>
                        <InputText @bind-Value="model.Address" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">City</label>
                        <InputText @bind-Value="model.City" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Payment Method</label>
                        <InputSelect @bind-Value="model.PaymentMethod" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500">
                            <option value="Card">Credit / Debit Card</option>
                            <option value="GCash">GCash</option>
                            <option value="Cash on Delivery">Cash on Delivery</option>
                        </InputSelect>
                    </div>

                    @if (model.PaymentMethod == "Card")
                    {
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-1">Card Number</label>
                            <InputText @bind-Value="model.CardNumber" placeholder="1234 5678 9012 3456" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-1">Expiry (MM/YY)</label>
                                <InputText @bind-Value="model.Expiry" placeholder="08/28" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-1">CVV</label>
                                <InputText @bind-Value="model.Cvv" type="password" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                            </div>
                        </div>
                    }

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl shadow-lg shadow-indigo-600/20 text-sm transition-all mt-4">
                        Pay $@StoreService.GetCartTotal().ToString("N2")
                    </button>
                </EditForm>
            </div>

            <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-3xl p-6 h-fit">
                <h2 class="font-black text-white mb-4">Order Summary</h2>
                <div class="space-y-3 text-xs text-slate-300">
                    @foreach (var i in StoreService.Cart)
                    {
                        <div class="flex justify-between gap-2">
                            <span>@i.Quantity × @i.Product.Name <span class="text-slate-500">(@i.SelectedSwitch)</span></span>
                            <span>$@i.Subtotal.ToString("N2")</span>
                        </div>
                    }
                    <div class="flex justify-between border-t border-slate-800 pt-3 font-black text-white text-sm">
                        <span>Total</span><span>$@StoreService.GetCartTotal().ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private MidtermProject.Models.CheckoutModel model = new();
    private MidtermProject.Models.Order? order;
    private string error = "";

    protected override void OnInitialized()
    {
        if (!StoreService.IsLoggedIn)
        {
            Nav.NavigateTo("/login?returnUrl=/checkout");
            return;
        }
        model.FullName = StoreService.CurrentUser;
    }

    private void Pay()
    {
        error = "";
        if (model.PaymentMethod == "Card")
        {
            var digits = new string(model.CardNumber.Where(char.IsDigit).ToArray());
            if (digits.Length < 13 || digits.Length > 19) { error = "Enter a valid card number."; return; }
            if (!System.Text.RegularExpressions.Regex.IsMatch(model.Expiry.Trim(), @"^(0[1-9]|1[0-2])\/\d{2}$")) { error = "Expiry must be MM/YY."; return; }
            if (model.Cvv.Length < 3 || model.Cvv.Length > 4 || !model.Cvv.All(char.IsDigit)) { error = "Enter a valid CVV."; return; }
        }

        order = StoreService.PlaceOrder(model.FullName, $"{model.Address}, {model.City}", model.PaymentMethod);
    }
}
