@page "/checkout"
@inject MidtermProject.Services.KeylabStoreService StoreService
@inject NavigationManager Nav

<PageTitle>Checkout — KEYLAB</PageTitle>

<div class="max-w-5xl mx-auto px-6 py-12">
    @if (order != null)
    {
        <div class="max-w-lg mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-8 text-center shadow-2xl">
            <div class="mx-auto w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-3xl font-black mb-4">✓</div>
            <h1 class="text-2xl font-black text-white">Order Confirmed!</h1>
            <p class="text-slate-400 text-sm mt-2">Thank you, <span class="text-white font-semibold">@order.CustomerName</span>. Your order has been placed and saved to the database.</p>
            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 mt-6 text-left space-y-2 text-xs text-slate-300">
                <div class="flex justify-between items-center pb-2 border-b border-slate-800">
                    <span class="text-slate-400 font-medium">Order Number</span>
                    <span class="text-indigo-400 font-mono font-bold text-sm">@order.Id</span>
                </div>
                <div class="py-2 space-y-1.5">
                    @foreach (var i in order.Items)
                    {
                        <div class="flex justify-between">
                            <span>@i.Quantity × @i.Product.Name (@i.SelectedSwitch)</span>
                            <span class="font-medium">$@i.Subtotal.ToString("N2")</span>
                        </div>
                    }
                </div>
                <div class="flex justify-between border-t border-slate-800 pt-2 font-black text-white text-sm">
                    <span>Total Amount</span>
                    <span class="text-emerald-400">$@order.Total.ToString("N2")</span>
                </div>
                <div class="pt-2 border-t border-slate-800/60 text-slate-400 space-y-0.5">
                    <p><span class="font-semibold text-slate-300">Deliver to:</span> @order.Address</p>
                    <p><span class="font-semibold text-slate-300">Payment:</span> @order.PaymentMethod</p>
                </div>
            </div>
            <a href="/shop" class="block mt-6 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl text-sm transition-all shadow-lg shadow-indigo-600/20">
                Continue Shopping
            </a>
        </div>
    }
    else if (!StoreService.Cart.Any())
    {
        <h1 class="text-3xl font-black text-white mb-4">Checkout</h1>
        <p class="text-slate-400 text-sm">Your cart is empty. <a href="/shop" class="text-indigo-400 hover:underline">Browse products</a></p>
    }
    else
    {
        <h1 class="text-3xl font-black text-white mb-6">Checkout</h1>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
            <div class="lg:col-span-3 bg-slate-900 border border-slate-800 rounded-3xl p-6">
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="bg-red-500/10 border border-red-500/50 text-red-400 text-xs p-3 rounded-xl mb-4 font-semibold">@error</div>
                }
                <EditForm Model="model" FormName="checkoutForm" OnValidSubmit="Pay" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
                        <InputText @bind-Value="model.FullName" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                        <ValidationMessage For="() => model.FullName" class="text-red-400 text-xs mt-1" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Address</label>
                        <InputText @bind-Value="model.Address" placeholder="Street name, Building, House #" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                        <ValidationMessage For="() => model.Address" class="text-red-400 text-xs mt-1" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">City</label>
                        <InputText @bind-Value="model.City" placeholder="City / Municipality" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500" />
                        <ValidationMessage For="() => model.City" class="text-red-400 text-xs mt-1" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Payment Method</label>
                        <div class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 flex items-center justify-between text-sm text-white">
                            <div class="flex items-center gap-3">
                                <span class="text-xl">💵</span>
                                <div>
                                    <div class="font-bold text-white text-sm">Cash on Delivery (COD)</div>
                                    <div class="text-xs text-slate-400">Pay cash upon delivery of your package</div>
                                </div>
                            </div>
                            <span class="text-xs bg-indigo-500/20 text-indigo-300 font-semibold px-2.5 py-1 rounded-full">Default</span>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-indigo-600/25 text-sm transition-all mt-4 cursor-pointer">
                        Confirm & Place Order · $@StoreService.GetCartTotal().ToString("N2")
                    </button>
                </EditForm>
            </div>

            <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-3xl p-6 h-fit">
                <h2 class="font-black text-white mb-4">Order Summary</h2>
                <div class="space-y-3 text-xs text-slate-300">
                    @foreach (var i in StoreService.Cart)
                    {
                        <div class="flex justify-between gap-2">
                            <span>@i.Quantity × @i.Product.Name <span class="text-slate-500">(@i.SelectedSwitch)</span></span>
                            <span class="font-medium">$@i.Subtotal.ToString("N2")</span>
                        </div>
                    }
                    <div class="flex justify-between border-t border-slate-800 pt-3 font-black text-white text-sm">
                        <span>Total</span><span class="text-emerald-400 font-bold">$@StoreService.GetCartTotal().ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private MidtermProject.Models.CheckoutModel model = new();
    private MidtermProject.Models.Order? order;
    private string error = "";

    protected override void OnInitialized()
    {
        if (!StoreService.IsLoggedIn)
        {
            Nav.NavigateTo("/login?returnUrl=/checkout");
            return;
        }
        model.FullName = StoreService.CurrentUser;
    }

    private void Pay()
    {
        error = "";
        try
        {
            if (string.IsNullOrWhiteSpace(model.FullName)) { error = "Full name is required."; return; }
            if (string.IsNullOrWhiteSpace(model.Address)) { error = "Address is required."; return; }
            if (string.IsNullOrWhiteSpace(model.City)) { error = "City is required."; return; }

            order = StoreService.PlaceOrder(model.FullName, $"{model.Address}, {model.City}", model.PaymentMethod);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            error = $"Could not complete transaction: {ex.Message}";
            StateHasChanged();
        }
    }
}
