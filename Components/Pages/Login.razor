@page "/login"
@inject MidtermProject.Services.KeylabStoreService Store
@inject NavigationManager Nav

<PageTitle>Sign In — KEYLAB</PageTitle>

<div class="min-h-[calc(100vh-10rem)] flex items-center justify-center px-4">
    <div class="glass-card max-w-md w-full p-8 shadow-glow-violet animate-fade-up">
        <h1 class="text-2xl font-black text-center">Welcome <span class="text-gradient">back</span></h1>
        <p class="text-slate-400 text-xs text-center mt-1 mb-7">Sign in to your KEYLAB account.</p>

        <EditForm Model="_model" FormName="loginForm" OnValidSubmit="HandleLogin" class="space-y-5">
            <DataAnnotationsValidator />
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-500/10 border border-red-500/40 text-red-300 text-xs p-3 rounded-xl font-semibold">@_error</div>
            }

            <div class="float-field">
                <InputText @bind-Value="_model.EmailOrUsername" class="input peer" placeholder=" " autocomplete="username" />
                <label>Email</label>
                <ValidationMessage For="() => _model.EmailOrUsername" />
            </div>

            <div class="float-field">
                <InputText @bind-Value="_model.Password" type="@(_show ? "text" : "password")" class="input peer pr-14" placeholder=" " autocomplete="current-password" />
                <label>Password</label>
                <button type="button" @onclick="() => _show = !_show" class="absolute right-3 top-3 text-[11px] font-bold text-slate-400 hover:text-neon-cyan">@(_show ? "HIDE" : "SHOW")</button>
                <ValidationMessage For="() => _model.Password" />
            </div>

            <button type="submit" class="btn-primary w-full !py-3.5">Sign In</button>
        </EditForm>

        <p class="text-xs text-slate-500 text-center mt-6">
            No account? <a href="/register" class="text-neon-cyan hover:underline">Sign up</a>
        </p>
    </div>
</div>

@code {
    private readonly MidtermProject.Models.LoginModel _model = new();
    private string _error = "";
    private bool _show;

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private void HandleLogin()
    {
        if (!Store.Login(_model.EmailOrUsername, _model.Password))
        {
            _error = "Invalid email or password.";
            return;
        }

        Store.ShowToast($"Welcome back, {Store.CurrentUser}!");
        var safe = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//");
        Nav.NavigateTo(safe ? ReturnUrl! : "/home");
    }
}
