@page "/cart"
@implements IDisposable
@inject MidtermProject.Services.KeylabStoreService Store

<PageTitle>Cart — KEYLAB</PageTitle>

<div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h1 class="section-title mb-8">Your <span class="text-gradient">cart</span></h1>

    @if (!Store.Cart.Any())
    {
        <div class="glass-card p-14 text-center">
            <p class="text-5xl">🛒</p>
            <p class="font-bold mt-4">Your cart is empty.</p>
            <a href="/shop" class="btn-primary mt-6">Browse products</a>
        </div>
    }
    else
    {
        <div class="grid lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2 space-y-4">
                @foreach (var item in Store.Cart.ToList())
                {
                    <div @key="item" class="glass-card p-4 flex flex-wrap sm:flex-nowrap items-center gap-4">
                        <a href="/product/@item.Product.Id"><img src="@item.Product.PrimaryImageUrl" alt="" class="h-20 w-24 object-cover rounded-xl" /></a>
                        <div class="flex-1 min-w-[10rem]">
                            <a href="/product/@item.Product.Id" class="font-extrabold hover:text-neon-cyan">@item.Product.Name</a>
                            <p class="text-xs text-slate-400 mt-0.5">@item.SelectedColor · @item.SelectedSwitch</p>
                            <p class="text-xs font-bold mt-1">$@item.Product.Price.ToString("N2")</p>
                        </div>
                        <div class="glass rounded-xl flex items-center">
                            <button @onclick="() => Store.ChangeQuantity(item, -1)" class="h-9 w-9 hover:text-neon-cyan" aria-label="Decrease">−</button>
                            <span class="w-8 text-center font-mono text-sm font-bold">@item.Quantity</span>
                            <button @onclick="() => Store.ChangeQuantity(item, 1)" class="h-9 w-9 hover:text-neon-cyan" aria-label="Increase">+</button>
                        </div>
                        <span class="font-black w-24 text-right">$@item.Subtotal.ToString("N2")</span>
                        <button @onclick="() => Store.RemoveFromCart(item)" class="btn-danger !px-3 !py-2 !text-xs">Remove</button>
                    </div>
                }
                <button @onclick="Store.ClearCart" class="text-xs text-slate-500 hover:text-red-400">Clear cart</button>
            </div>

            <aside class="glass-card p-6 space-y-5 lg:sticky lg:top-28">
                <h2 class="font-black text-lg">Order Summary</h2>

                <div>
                    @if (string.IsNullOrEmpty(Store.AppliedPromo))
                    {
                        <div class="flex gap-2">
                            <input @bind="_promo" @bind:event="oninput" @onkeydown="OnPromoKey" placeholder="Promo code" class="input !py-2.5 !placeholder-slate-500 uppercase" />
                            <button @onclick="ApplyPromo" class="btn-ghost !px-4 !text-xs">Apply</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_promoError)) { <p class="validation-message">@_promoError</p> }
                        <p class="text-[11px] text-slate-500 mt-1.5">Try <span class="font-mono text-slate-400">KEYLAB10</span> or <span class="font-mono text-slate-400">THOCK20</span></p>
                    }
                    else
                    {
                        <div class="flex items-center justify-between rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-3 py-2 text-xs">
                            <span class="font-mono font-bold text-emerald-300">@Store.AppliedPromo · @Store.DiscountRate.ToString("P0") off</span>
                            <button @onclick="Store.RemovePromo" class="text-slate-400 hover:text-white">✕</button>
                        </div>
                    }
                </div>

                <dl class="space-y-2.5 text-sm">
                    <div class="flex justify-between"><dt class="text-slate-400">Subtotal</dt><dd>$@Store.Subtotal.ToString("N2")</dd></div>
                    @if (Store.Discount > 0)
                    {
                        <div class="flex justify-between text-emerald-300"><dt>Discount</dt><dd>−$@Store.Discount.ToString("N2")</dd></div>
                    }
                    <div class="flex justify-between"><dt class="text-slate-400">Tax (@MidtermProject.Services.KeylabStoreService.TaxRate.ToString("P0"))</dt><dd>$@Store.Tax.ToString("N2")</dd></div>
                    <div class="flex justify-between"><dt class="text-slate-400">Shipping</dt><dd>@(Store.Shipping == 0 ? "FREE" : "$" + Store.Shipping.ToString("N2"))</dd></div>
                    <div class="flex justify-between border-t border-white/10 pt-3 text-lg font-black"><dt>Total</dt><dd class="text-gradient">$@Store.GrandTotal.ToString("N2")</dd></div>
                </dl>

                @if (Store.AmountToFreeShipping > 0)
                {
                    <p class="text-[11px] text-slate-400">Add <span class="text-neon-cyan font-bold">$@Store.AmountToFreeShipping.ToString("N2")</span> more for free shipping.</p>
                }

                <a href="/checkout" class="btn-primary w-full !py-3.5">Proceed to Checkout</a>
            </aside>
        </div>
    }
</div>

@code {
    private string _promo = "";
    private string _promoError = "";

    protected override void OnInitialized() => Store.OnChange += HandleChange;

    private void HandleChange() => _ = InvokeAsync(StateHasChanged);

    private void ApplyPromo()
    {
        var (ok, message) = Store.ApplyPromo(_promo);
        _promoError = ok ? "" : message;
        if (ok) { _promo = ""; Store.ShowToast(message); }
    }

    private void OnPromoKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyPromo();
    }

    public void Dispose() => Store.OnChange -= HandleChange;
}
