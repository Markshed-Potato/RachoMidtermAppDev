@page "/shop"
@inject MidtermProject.Services.KeylabStoreService StoreService

<PageTitle>Shop — KEYLAB</PageTitle>

<div class="max-w-7xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row gap-8 items-start">
        <!-- Dynamic Sidebar Filters -->
        <aside class="w-full md:w-64 flex-none space-y-6">
            <!-- Category Filter -->
            <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="font-bold text-white text-sm">Categories</h3>
                    @if (!string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(selectedLayout))
                    {
                        <button @onclick="ResetFilters" class="text-[11px] text-indigo-400 hover:underline">Reset</button>
                    }
                </div>
                <div class="space-y-1 text-xs">
                    <button @onclick='() => SelectCategory("")'
                            class="w-full text-left px-3 py-2 rounded-xl transition-all @(string.IsNullOrEmpty(selectedCategory) ? "bg-indigo-600 text-white font-bold" : "text-slate-400 hover:bg-slate-800 hover:text-white")">
                        All Products
                    </button>
                    @foreach (var c in Categories)
                    {
                        <button @onclick="() => SelectCategory(c)"
                                class="w-full text-left px-3 py-2 rounded-xl transition-all @(selectedCategory == c ? "bg-indigo-600 text-white font-bold" : "text-slate-400 hover:bg-slate-800 hover:text-white")">
                            @c
                        </button>
                    }
                </div>
            </div>

            <!-- Layout Filter (Relevant for Keyboards) -->
            @if (string.IsNullOrEmpty(selectedCategory) || selectedCategory == "Keyboards")
            {
                <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
                    <h3 class="font-bold text-white text-sm mb-3">Keyboard Layout</h3>
                    <div class="space-y-1.5 text-xs text-slate-400">
                        @foreach (var l in new[] { "60%", "65%", "75%", "TKL", "Full" })
                        {
                            <label class="flex items-center gap-2.5 p-1 rounded hover:text-white cursor-pointer">
                                <input type="checkbox" @onchange="() => ToggleLayout(l)" checked="@(selectedLayout == l)" class="rounded bg-slate-950 border-slate-700 text-indigo-600 focus:ring-0" />
                                <span>@l</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </aside>

        <!-- Product Grid -->
        <main class="flex-1 min-w-0 w-full">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-2xl font-black text-white">
                    @(string.IsNullOrEmpty(selectedCategory) ? "All Products" : selectedCategory)
                    @if (!string.IsNullOrEmpty(selectedLayout))
                    {
                        <span class="text-indigo-400 text-base font-normal"> · @selectedLayout</span>
                    }
                </h1>
                <span class="text-xs text-slate-400 font-medium">Showing @FilteredProducts.Count() products</span>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div class="py-16 text-center bg-slate-900 border border-slate-800 rounded-3xl p-8">
                    <div class="text-4xl mb-3">🔍</div>
                    <h3 class="text-lg font-bold text-white">No products found</h3>
                    <p class="text-slate-400 text-xs mt-1 max-w-sm mx-auto">No products match your current filter combination. Try clearing your filters to see available inventory.</p>
                    <button @onclick="ResetFilters" class="mt-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition-all shadow-md">
                        Clear All Filters
                    </button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in FilteredProducts)
                    {
                        <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm flex flex-col justify-between hover:border-slate-700 transition-all group">
                            <div>
                                <div class="relative overflow-hidden rounded-xl mb-3 bg-slate-950">
                                    @if (p.IsOnSale)
                                    {
                                        <span class="absolute top-2 left-2 z-10 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase">Sale</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.BadgeText) && !p.IsOnSale)
                                    {
                                        <span class="absolute top-2 left-2 z-10 bg-indigo-600 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase">@p.BadgeText</span>
                                    }
                                    <a href="/product/@p.Id">
                                        <img src="@p.PrimaryImageUrl" alt="@p.Name" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=600&auto=format&fit=crop';" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
                                    </a>
                                </div>
                                <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                                    <span>@p.Category</span>
                                    @if (p.Category == "Keyboards" && !string.IsNullOrEmpty(p.Layout) && p.Layout != "—")
                                    {
                                        <span class="text-indigo-400 font-semibold">@p.Layout</span>
                                    }
                                </div>
                                <a href="/product/@p.Id" class="block font-bold text-white text-base hover:text-indigo-400 transition-colors">
                                    @p.Name
                                </a>
                                <p class="text-xs text-amber-500 my-1">★ @p.Rating.ToString("F1") <span class="text-slate-400">(@p.ReviewCount)</span></p>
                            </div>
                            <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-800">
                                <span class="font-black text-white text-lg">$@p.Price.ToString("N2")</span>
                                <button @onclick="() => StoreService.AddToCart(p)" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-md">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cat")] public string? Cat0 { get; set; }

    private string selectedCategory = "";
    private string selectedLayout = "";

    private IEnumerable<string> Categories =>
        StoreService.GetProducts().Select(p => p.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().OrderBy(c => c);

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Cat0))
        {
            selectedCategory = Cat0;
            selectedLayout = "";
        }
    }

    private void SelectCategory(string c)
    {
        selectedCategory = c;
        if (c != "Keyboards")
        {
            selectedLayout = "";
        }
    }

    private void ToggleLayout(string l) => selectedLayout = selectedLayout == l ? "" : l;

    private void ResetFilters()
    {
        selectedCategory = "";
        selectedLayout = "";
    }

    private IEnumerable<MidtermProject.Models.Product> FilteredProducts =>
        StoreService.GetProducts()
            .Where(p => string.IsNullOrEmpty(selectedCategory) || p.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(selectedLayout) || (p.Category == "Keyboards" && p.Layout == selectedLayout));
}
