@inherits LayoutComponentBase
@implements IDisposable
@inject MidtermProject.Services.KeylabStoreService StoreService
@inject NavigationManager Nav

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-50 bg-slate-950 text-slate-100 border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <!-- Brand Logo -->
            <a href="/home" class="text-xl font-black tracking-widest text-white uppercase flex items-center gap-2">
                <span class="bg-indigo-600 text-white p-1.5 rounded-lg text-xs font-bold">KL</span>
                <span>KEYLAB</span>
            </a>

            <!-- Category Links -->
            <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-400">
                <a href="/shop" class="hover:text-indigo-400 transition-colors">All Products</a>
                <a href="/shop?cat=Keyboards" class="hover:text-indigo-400 transition-colors">Keyboards</a>
                <a href="/shop?cat=Switches" class="hover:text-indigo-400 transition-colors">Switches</a>
                <a href="/shop?cat=Keycaps" class="hover:text-indigo-400 transition-colors">Keycaps</a>
                <a href="/shop?cat=Accessories" class="hover:text-indigo-400 transition-colors">Accessories</a>
            </nav>

            <!-- Search & Actions -->
            <div class="flex items-center gap-4">
                <a href="/cart" class="relative bg-slate-900 border border-slate-800 p-2.5 rounded-xl text-slate-300 hover:text-white transition-colors flex items-center gap-2 text-xs font-semibold">
                    <span>Cart</span>
                    <span class="bg-indigo-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                        @StoreService.GetCartCount()
                    </span>
                </a>

                @if (StoreService.IsLoggedIn)
                {
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold text-indigo-400">Hi, @StoreService.CurrentUser</span>
                        <button @onclick="HandleLogout" class="text-xs text-slate-400 hover:text-red-400 transition-colors border border-slate-800 px-3 py-1.5 rounded-xl bg-slate-900">
                            Log Out
                        </button>
                    </div>
                }
                else
                {
                    <a href="/login" class="text-xs font-semibold text-slate-300 hover:text-white transition-colors">Log In</a>
                    <a href="/register" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-lg shadow-indigo-600/20 transition-all">Sign Up</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800/80 py-8 text-center text-xs text-slate-500">
        <p>&copy; 2026 KEYLAB Inc. All rights reserved.</p>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        StoreService.OnChange += OnStoreChanged;
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private void HandleLogout()
    {
        StoreService.Logout();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        StoreService.OnChange -= OnStoreChanged;
    }
}