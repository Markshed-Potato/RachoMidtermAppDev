@inherits LayoutComponentBase
@implements IDisposable
@inject MidtermProject.Services.KeylabStoreService Store
@inject NavigationManager Nav

<div class="min-h-screen flex flex-col">
    <header class="fixed top-3 inset-x-0 z-50 px-3 sm:px-6">
        <div class="glass max-w-7xl mx-auto rounded-2xl px-4 h-16 flex items-center gap-3 sm:gap-5 shadow-2xl shadow-black/40">
            <a href="/home" class="flex items-center gap-2 shrink-0">
                <span class="grid place-items-center h-8 w-8 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-violet text-ink-950 text-xs font-black shadow-glow">KL</span>
                <span class="hidden sm:block font-black tracking-[.25em] text-sm">KEYLAB</span>
            </a>

            <form @onsubmit="Search" @onsubmit:preventDefault class="hidden md:flex flex-1 max-w-xl items-center rounded-xl border border-white/10 bg-ink-950/50 focus-within:border-neon-cyan/60 transition">
                <select @bind="category" class="bg-transparent text-xs text-slate-300 pl-3 pr-1 py-2.5 outline-none border-r border-white/10 cursor-pointer">
                    <option value="" class="bg-ink-900">All</option>
                    @foreach (var c in Categories)
                    {
                        <option value="@c" class="bg-ink-900">@c</option>
                    }
                </select>
                <input @bind="query" @bind:event="oninput" placeholder="Search boards, switches, keycaps…" class="flex-1 bg-transparent px-3 py-2.5 text-sm outline-none placeholder:text-slate-500" />
                <button type="submit" class="px-3 text-slate-400 hover:text-neon-cyan" aria-label="Search">🔍</button>
            </form>

            <div class="flex-1 md:hidden"></div>

            <nav class="flex items-center gap-2 sm:gap-3">
                <a href="/shop" class="hidden lg:block text-xs font-semibold text-slate-300 hover:text-neon-cyan px-2">Shop</a>

                <a href="/cart" class="relative btn-ghost !px-3 !py-2 !text-xs" aria-label="Cart">
                    <span>🛒</span><span class="hidden sm:inline">Cart</span>
                    @if (Store.GetCartCount() > 0)
                    {
                        <span class="absolute -top-2 -right-2 min-w-[1.25rem] h-5 px-1 grid place-items-center rounded-full bg-neon-pink text-[10px] font-black text-white shadow-[0_0_12px_rgba(244,114,182,.7)]">@Store.GetCartCount()</span>
                    }
                </a>

                @if (Store.IsLoggedIn)
                {
                    <div class="relative">
                        <button @onclick="() => menuOpen = !menuOpen" class="grid place-items-center h-10 w-10 rounded-full bg-gradient-to-br from-neon-violet to-neon-cyan text-ink-950 text-xs font-black ring-2 ring-white/10 hover:ring-neon-cyan/60 transition" aria-label="Account menu">@Store.Initials</button>
                        @if (menuOpen)
                        {
                            <div class="fixed inset-0 z-40" @onclick="() => menuOpen = false"></div>
                            <div class="glass absolute right-0 mt-3 w-56 rounded-xl p-2 z-50 animate-fade-up bg-ink-900/90">
                                <div class="px-3 py-2 border-b border-white/10 mb-1">
                                    <p class="text-sm font-bold truncate">@Store.CurrentUser</p>
                                    <p class="text-[11px] text-slate-400 truncate">@Store.CurrentEmail</p>
                                </div>
                                <a href="/cart" @onclick="() => menuOpen = false" class="block rounded-lg px-3 py-2 text-xs hover:bg-white/10">My Cart</a>
                                <a href="/shop" @onclick="() => menuOpen = false" class="block rounded-lg px-3 py-2 text-xs hover:bg-white/10">Continue Shopping</a>
                                <button @onclick="Logout" class="w-full text-left rounded-lg px-3 py-2 text-xs text-red-300 hover:bg-red-500/10">Log Out</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <a href="/login" class="text-xs font-semibold text-slate-300 hover:text-white px-2">Log In</a>
                    <a href="/register" class="btn-primary !py-2 !px-4 !text-xs">Sign Up</a>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1 pt-24">@Body</main>

    <footer class="mt-24 border-t border-white/10 py-10 text-center text-xs text-slate-500">
        <p class="font-mono tracking-widest text-slate-400">KEYLAB // THOCK RESPONSIBLY</p>
        <p class="mt-2">&copy; 2026 KEYLAB Inc. All rights reserved.</p>
    </footer>
</div>

<MidtermProject.Components.Shared.ToastHost />

@code {
    private string query = "";
    private string category = "";
    private bool menuOpen;

    private IEnumerable<string> Categories => Store.GetProducts().Select(p => p.Category).Distinct().OrderBy(c => c);

    protected override void OnInitialized()
    {
        Store.OnChange += OnStoreChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Search()
    {
        var url = "/shop";
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(category)) qs.Add("cat=" + Uri.EscapeDataString(category));
        if (!string.IsNullOrWhiteSpace(query)) qs.Add("q=" + Uri.EscapeDataString(query.Trim()));
        Nav.NavigateTo(qs.Count > 0 ? url + "?" + string.Join("&", qs) : url);
    }

    private void Logout()
    {
        menuOpen = false;
        Store.Logout();
        Store.ShowToast("Logged out.", MidtermProject.Services.ToastKind.Info);
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
